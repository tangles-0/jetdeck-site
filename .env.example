# Postgres connection string (Neon: copy the pooled connection string).
# The app reads DATABASE_URI first, then DATABASE_URL, then POSTGRES_URL.
# Vercel's Neon/Postgres integrations may create POSTGRES_URL automatically.
DATABASE_URI=postgres://user:password@host/dbname?sslmode=require

# Used to encrypt Payload sessions/tokens. Generate with: openssl rand -hex 32
PAYLOAD_SECRET=changeme

# Vercel Blob storage for media uploads (required on Vercel, optional locally).
# Created automatically when you add a Blob store to your Vercel project.
# When unset, uploads are stored on the local filesystem in ./media
BLOB_READ_WRITE_TOKEN=
